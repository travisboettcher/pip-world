# The same service as docker-compose.yml, as an hll source: https://github.com/travisboettcher/hl-lang
# Generate the Compose file with `hllc build pip-world.hll --out docker-compose.yml` (docker-compose.yml is what the
# project ships and tests; this is an alternative for people who already manage their services with hll).
# To build from this checkout instead of pulling the published image, replace the `image` line with `build "."`.
# Modules need the pip-runner sandbox, which must have no network at all; hll gives every service in a multi-service file a network,
# so pip-runner lives in docker-compose.yml only (or in a single-service .hll of its own, sharing the `pip-runner-socket` volume by name).
volume pip-world-data {}

service pip-world {
  image "ghcr.io/travisboettcher/pip-world:latest"
  container_name "pip-world"
  env_file ".env"
  restart unless-stopped
  # The dashboard and API have no login and include write endpoints: keep them on this machine
  # unless something in front of them handles access (a VPN, or a reverse proxy with auth).
  publish "127.0.0.1:8000" -> 8000
  volume pip-world-data -> "/data"
  # Optional: Pip's instructions (re-read every tick) and a folder of books for its library.
  # volume "./persona.md" -> "/srv/persona.md" { read_only }
  # volume "./books" -> "/library" { read_only }
}
