#!/usr/bin/env python3
"""Talk to Pip, the agent_world agent. Stdlib only.

  pipchat                       interactive chat (slash commands work inside it too)
  pipchat "hello there"         say something, print the reply, exit
  pipchat status | usage | health
  pipchat give "tiny needle file" [--kind tool|material|food|seed] [-q N] [--message "for the clock!"]
  pipchat items | garden | projects | creations
  pipchat memory | reflect | recall "what Morgan said about the clock"
  pipchat letters               the neighbor and the letters between them and Pip
  pipchat library [query]       books Pip is reading, or search the library
  pipchat notes [section] [--status open|done] [-n N]
  pipchat log [N] [--kind KIND ...]          pipchat watch [--kind KIND ...]
  pipchat tick                  wake Pip now
  pipchat --json <command>      machine-readable output (watch emits JSON lines)

Set PIP_URL (or --url) if Pip isn't at the default Traefik address.
"""
import argparse
import json
import os
import shlex
import sys
import time
import urllib.error
import urllib.parse
import urllib.request

DEFAULT_URL = "https://agent-world.internal.example.io"
DEFAULT_SENDER = os.environ.get("PIP_NAME") or "Morgan"  # who you are to Pip (it remembers people by name)
SECTIONS = ["diary", "todo", "wishlist", "ambitions", "learned"]
TTY = sys.stdout.isatty()
REPLY_TIMEOUT = 120   # Pip wakes within ~MIN_TICK_INTERVAL of a message, then thinks
LINGER = 6            # keep listening this long after the reply for follow-up actions
JSON_MODE = False

# USD per million tokens (input, output) for the cost estimate in `usage`. Override with
# PIP_PRICE_IN / PIP_PRICE_OUT. Flat rates: prompts here stay far below the >100k-token tier.
PRICES = {"claude-haiku-5-5": (0.10, 0.50)}


def c(code: str, text: str) -> str:
    return f"\033[{code}m{text}\033[0m" if TTY else text


dim, green, yellow, red, bold, cyan = (lambda t, k=k: c(k, t) for k in ("2", "32", "33", "31", "1", "36"))


def out_json(obj) -> None:
    print(json.dumps(obj, indent=2, ensure_ascii=False))


class Pip:
    def __init__(self, url: str):
        self.url = url.rstrip("/")

    def call(self, path: str, body: dict | None = None, method: str | None = None):
        data = json.dumps(body).encode() if body is not None else (b"" if method == "POST" else None)
        req = urllib.request.Request(
            self.url + path, data=data, method=method or ("POST" if body is not None else "GET"),
            headers={"content-type": "application/json"},
        )
        with urllib.request.urlopen(req, timeout=15) as r:
            return json.load(r)

    def cursor(self) -> int:
        evs = self.call("/events?limit=1")
        return evs[0]["id"] if evs else 0


# --- formatting ---------------------------------------------------------------

def fmt_time(ts: float) -> str:
    return time.strftime("%b %d %H:%M:%S", time.localtime(ts))


def describe_state(st: dict) -> str:
    a = st["agent"]
    now = a["activity"] + (f" - {a['description']}" if a.get("description") else "")
    u = st["usage"]
    return (f"Pip is {bold(now)}\n"
            f"  mood {a['mood']} | hunger {a['hunger']:.2f} | energy {a['energy']:.2f} | location {a['location']}\n"
            f"  {st['model']} via {st['backend']} | pacing {st['pacing']} | ticks since start {st['ticks']} | "
            f"inbox waiting {st['pending_inbox']}\n"
            f"  tools: {', '.join(st['tools'])}\n"
            f"  tokens today {u['total_tokens']}/{u['budget']}")


def format_event(e: dict, verbose: bool = False) -> str | None:
    d, k = e["data"], e["kind"]
    if k == "say":
        return green("pip> ") + (d["text"] or dim("(says nothing)"))
    if k == "tool":
        t, a = d["tool"], d["args"]
        if t == "say":
            return dim(f"  * Pip says: {a.get('text')}") if verbose else None  # shown via the "say" event
        if t == "set_activity":
            return dim(f"  * Pip is now {a.get('activity')}" + (f" - {a['description']}" if a.get("description") else ""))
        if t == "note_to_self":
            sec = a.get("section", "diary")
            where = {"diary": "in its diary", "todo": "on its to-do list", "wishlist": "on its wishlist",
                     "ambitions": "under ambitions", "learned": "under things learned"}.get(sec, f"in {sec}")
            return dim(f"  * Pip writes {where}: {a.get('text')}")
        if t == "edit_note":
            if str(d.get("result", "")).startswith(("error", "not edited")):
                return yellow(f"  ! Pip couldn't edit #{a.get('id')}: {d.get('result')}")
            return dim(f"  * Pip rewrites #{a.get('id')}: {a.get('text')}")
        if t == "resolve_note":
            return dim(f"  * Pip crosses off #{a.get('id')}" + (f": {a['outcome']}" if a.get("outcome") else ""))
        if t == "use_item":
            return dim(f"  * Pip uses {a.get('item')}" + (f" - {a['purpose']}" if a.get("purpose") else ""))
        if t == "plant":
            return dim(f"  * Pip plants {a.get('seed')}" + (f" in plot {a['plot']}" if a.get("plot") else ""))
        if t == "harvest":
            return dim(f"  * Pip harvests: {d.get('result')}")
        if t == "eat" and a.get("item"):
            return dim(f"  * Pip eats {a['item']}")
        if t == "web_search":
            return dim(f"  * Pip searches the web for: {a.get('query')}")
        if t == "start_project":
            return dim(f"  * Pip starts a project: {a.get('name')}" + (f" - {a['goal']}" if a.get("goal") else ""))
        if t == "work_on":
            r = str(d.get("result", ""))
            return yellow(f"  ! {r}") if r.startswith(("error", "can't", "you're in the middle")) else \
                dim(f"  * Pip settles in to work on {a.get('project')}" + (f" for {a['minutes']} min" if a.get("minutes") else ""))
        if t == "abandon_project":
            return dim(f"  * Pip gives up on {a.get('project')}" + (f": {a['reason']}" if a.get("reason") else ""))
        if t == "write_letter":
            return None  # shown via the letter_sent event
        if t == "browse_library":
            return dim("  * Pip browses the library" + (f" for {a['query']!r}" if a.get("query") else ""))
        if t in ("go_to", "read"):
            return dim(f"  * Pip: {d.get('result')}")
        if t == "recall":
            return dim(f"  * Pip tries to remember: {a.get('query')}")
        if t == "tend":
            return dim(f"  * Pip {d.get('result')}")
        return dim(f"  * Pip uses {t}")
    if k == "gift":
        n = d.get("qty", 1)
        return yellow(f"  + {d['sender']} gives Pip {n} x {d['item']}")
    if k == "garden":
        return green(f"  * Pip's {d['crop']} in plot {d['plot']} are ripe")
    if k == "work":
        mark = {"setback": red, "breakthrough": green}.get(d["result"], dim)
        tail = " - finished!" if d["project_done"] else " (stage done)" if d["finished_stage"] else f" ({d['percent']}%)"
        if d.get("interrupted"):
            return dim(f"  * Pip stopped working on {d['project']} early{tail}")
        return mark(f"  ~ {d['project']}, {d['stage']}: {d['result']}") + dim(f" - {d['text']}{tail}")
    if k == "creation_made":
        tags = ", ".join([d["quality"], *d["capabilities"]])
        return green(f"  + Pip made {d['name']} ({tags}): {d['description']}")
    if k == "creation":
        return dim(f"  ~ {d['text']}") if d["what"] in ("stopped", "helper", "used") else dim(f"  ~ {d['name']}: {d['text']}")
    if k == "companion":
        return cyan(f"{d['name'].lower()}> ") + d["text"]
    if k == "inbox" and d.get("letter"):
        return cyan(f"  @ {d['text']}")
    if k == "arrived":
        return dim(f"  * Pip arrives at {d.get('label') or d['place']}" if d["place"] != "workshop" else "  * Pip gets home") + \
            (dim(f" - {d['description']}") if d.get("first_time") and d.get("description") else "")
    if k == "reading":
        tail = " - finished it!" if d.get("finished") else f" ({d['percent']}%)"
        return green(f"  ~ Pip reads {d['title']}{tail}") + dim(f" - {d['summary']}")
    if k == "letter_sent":
        return dim(f"  @ Pip writes to {d['to']}: {d['text']}") + (dim(f" (enclosed: {d['enclosed']})") if d.get("enclosed") else "")
    if k == "neighbor":
        return green(f"  + A neighbor: {d['name']} - {d['about']}")
    if k == "reflection":
        return green(f"  z Pip slept on it: {d['summary']}")
    if k == "reflection_error":
        return yellow("  ! Pip's nightly reflection failed; it will try again in an hour")
    if k == "tool_error":
        return yellow(f"  ! tool {d.get('tool')} failed: {d.get('error')}")
    if k == "error":
        return red(f"  ! {d.get('error')}")
    if k == "budget_exceeded":
        return yellow("  ! Pip has used today's token budget and is asleep until tomorrow.")
    if k == "alert":
        return dim(f"  * Pip's {d['stat']} needs attention")
    if verbose:
        if k == "inbox" and not d.get("letter"):
            return dim(f"  < {d.get('sender') or 'visitor'}: {d['text']}")
        if k == "inbox_read":
            return dim(f"  . Pip read visitor message(s) {d['ids']}")
        if k == "tick":
            return dim(f"  . tick ({d['reason']}, step {d.get('step', 0)}, {d['tokens']} tokens)"
                       + (f": {d['text']}" if d.get("text") else ""))
        if k == "start":
            return dim(f"  . started: {d.get('model')} via {d.get('backend')}, pacing {d.get('pacing')}")
    return None


def print_events(events: list[dict], verbose: bool) -> None:
    for e in events:
        line = format_event(e, verbose)
        if line:
            print(f"{dim(fmt_time(e['ts']))} {line}" if verbose else line)


# --- commands -----------------------------------------------------------------

def cmd_status(pip: Pip, a) -> None:
    st = pip.call("/state")
    out_json(st) if JSON_MODE else print(describe_state(st))


def prices_for(model: str) -> tuple[float, float] | None:
    if os.environ.get("PIP_PRICE_IN") and os.environ.get("PIP_PRICE_OUT"):
        return float(os.environ["PIP_PRICE_IN"]), float(os.environ["PIP_PRICE_OUT"])
    return PRICES.get(model)


def cmd_usage(pip: Pip, a) -> None:
    st = pip.call("/state")
    u, price = st["usage"], prices_for(st["model"])
    cost = (u["input_tokens"] * price[0] + u["output_tokens"] * price[1]) / 1e6 if price else None
    if JSON_MODE:
        return out_json({**u, "model": st["model"], "estimated_cost_usd": cost})
    pct = 100 * u["total_tokens"] / u["budget"] if u["budget"] else 0
    filled = min(20, int(pct // 5))
    bar = "#" * filled + "." * (20 - filled)
    avg = u["total_tokens"] // u["calls"] if u["calls"] else 0
    print(f"{u['day']}: [{bar}] {pct:.1f}%  {u['total_tokens']:,}/{u['budget']:,} tokens")
    print(f"  {u['calls']} LLM calls ({u['input_tokens']:,} in, {u['output_tokens']:,} out), ~{avg:,} tokens/call")
    if not price:
        return print(dim(f"  (no price known for {st['model']}; set PIP_PRICE_IN / PIP_PRICE_OUT to see costs)"))
    mix_in = u["input_tokens"] / u["total_tokens"] if u["total_tokens"] else 0.9
    per_mtok = mix_in * price[0] + (1 - mix_in) * price[1]  # blended $/M tokens at today's in/out mix
    cap = u["budget"] * per_mtok / 1e6
    print(f"  est. cost today ${cost:.4f}  |  full budget at this mix ~${cap:.2f}/day (~${cap * 30:.0f}/month)")


def cmd_health(pip: Pip, a) -> None:
    t0 = time.time()
    r = pip.call("/healthz")
    ms = (time.time() - t0) * 1000
    out_json({**r, "latency_ms": round(ms)}) if JSON_MODE else print(f"{pip.url}: {'ok' if r.get('ok') else r} ({ms:.0f} ms)")


def cmd_notes(pip: Pip, a) -> None:
    notes = pip.call(f"/notes?limit={a.n}" + ("&status=archived" if a.status == "archived" else ""))
    if a.section:
        notes = {a.section: notes[a.section]}
    if a.status:
        notes = {s: [m for m in ms if m["status"] == a.status] for s, ms in notes.items()}
    if JSON_MODE:
        return out_json(notes)
    titles = {"diary": "Diary", "todo": "To-do", "wishlist": "Wishlist", "ambitions": "Ambitions", "learned": "Learned"}
    for sec, items in notes.items():
        print(bold(titles.get(sec, sec)))
        if not items:
            print(dim("  (nothing)"))
        for m in items:
            done = dim(f"  [done{': ' + m['outcome'] if m['outcome'] else ''}]") if m["status"] == "done" else ""
            done += dim("  (edited)") if m.get("edited_at") else ""
            print(f"  #{m['id']} {dim(fmt_time(m['ts']))}  {m['text']}{done}")


def cmd_log(pip: Pip, a) -> None:
    kinds = set(a.kind or [])
    n = a.count or a.n
    events = pip.call(f"/events?limit={500 if kinds else n}")
    if kinds:
        events = [e for e in events if e["kind"] in kinds]
    events = list(reversed(events[:n]))
    if JSON_MODE:
        return out_json(events)
    print_events(events, verbose=True)


def cmd_watch(pip: Pip, a) -> None:
    kinds = set(a.kind or [])
    if not JSON_MODE:
        print(dim("watching Pip live - Ctrl-C to stop"))
    cur = pip.cursor()
    try:
        while True:
            for e in pip.call(f"/events?after_id={cur}&limit=100"):
                cur = e["id"]
                if kinds and e["kind"] not in kinds:
                    continue
                if JSON_MODE:
                    print(json.dumps(e, ensure_ascii=False), flush=True)
                else:
                    print_events([e], verbose=True)
            time.sleep(1)
    except KeyboardInterrupt:
        print()


def cmd_tick(pip: Pip, a) -> None:
    pip.call("/tick", method="POST")
    out_json({"requested": True}) if JSON_MODE else print(dim("  poked."))


def cmd_say(pip: Pip, a) -> None:
    send_and_wait(pip, " ".join(a.message), sender=a.sender)


def send_and_wait(pip: Pip, text: str | None = None, path: str = "/inbox", body: dict | None = None,
                  sender: str = DEFAULT_SENDER) -> None:
    """POST a message (or a gift via path/body) to Pip, then show its reaction as it happens."""
    cur = pip.cursor()
    msg_id = pip.call(path, body if body is not None else {"text": text, "sender": sender})["id"]
    start, replied_at, spin, heard = time.time(), None, 0, False
    try:
        while True:
            for e in pip.call(f"/events?after_id={cur}&limit=100"):
                cur = e["id"]
                mine = msg_id in (e["data"].get("to") or e["data"].get("ids") or [])
                if e["kind"] == "say" and not mine:
                    continue
                if JSON_MODE:
                    print(json.dumps(e, ensure_ascii=False), flush=True)
                elif line := format_event(e):
                    if TTY:
                        print("\r\033[K", end="")
                    print(line)
                if e["kind"] in ("say", "inbox_read") and mine:
                    replied_at = replied_at or time.time()
                    heard = heard or e["kind"] == "say"
                if e["kind"] == "budget_exceeded":
                    return
            now = time.time()
            if replied_at and now - replied_at > LINGER:
                if not heard and not JSON_MODE:
                    print(dim("  (Pip read your message but chose not to say anything)"))
                return
            if not replied_at and now - start > REPLY_TIMEOUT:
                print(yellow("  Pip hasn't answered yet (it may be busy or paused). Your message is still queued."))
                return
            if TTY and not replied_at and not JSON_MODE:
                print(dim(f"\r  Pip is thinking{'.' * (spin % 4):<4}"), end="", flush=True)
                spin += 1
            time.sleep(1)
    except KeyboardInterrupt:
        print(dim("\n  (stopped waiting; your message is still queued)"))


def cmd_give(pip: Pip, a) -> None:
    attrs = {k: v for k, v in (("crop", a.crop), ("grow_minutes", a.grow_minutes), ("yield", a.yield_),
                               ("food_value", a.food_value)) if v is not None}
    body = {"name": a.name, "qty": a.quantity, "kind": a.kind, "description": a.desc or "",
            "sender": a.sender, "message": a.message or "", "attrs": attrs}
    send_and_wait(pip, path="/items", body=body)


def cmd_items(pip: Pip, a) -> None:
    items = pip.call("/items")
    if JSON_MODE:
        return out_json(items)
    print(bold("Belongings"))
    for i in items:
        extra = ""
        if i["kind"] == "seed":
            at = i["attrs"]
            extra = dim(f"  -> {at['crop']}, ~{at['grow_minutes']} min, yields {at['yield']}")
        elif i["kind"] == "food":
            extra = dim(f"  (fills {i['attrs'].get('food_value', 0.3)})")
        print(f"  {i['name']} x{i['qty']} [{i['kind']}]" + (f" - {i['description']}" if i["description"] else "") + extra)
    if not items:
        print(dim("  (nothing)"))


def cmd_garden(pip: Pip, a) -> None:
    plots = pip.call("/garden")
    if JSON_MODE:
        return out_json(plots)
    print(bold("Garden"))
    for g in plots:
        if g["state"] == "empty":
            print(f"  plot {g['plot']}: " + dim("empty"))
        elif g["state"] == "ready":
            print(f"  plot {g['plot']}: " + green(f"{g['crop']} - ripe, ready to harvest"))
        else:
            print(f"  plot {g['plot']}: {g['crop']} - ready in about {g['ready_in_min']} min")


def cmd_projects(pip: Pip, a) -> None:
    r = pip.call("/projects" + (f"?status={a.status}" if a.status else ""))
    if JSON_MODE:
        return out_json(r)
    print(bold("Projects"))
    for p in r["projects"]:
        head = f"  #{p['id']} {p['name']} [{p['status']}] {p['craft']}, difficulty {p['difficulty']}/5, {p['percent']}%"
        if p["working_until"]:
            head += green(f" - working, ~{max(1, round((p['working_until'] - time.time()) / 60))} min left")
        print(head)
        for i, st in enumerate(p["stages"]):
            mats = ", ".join(f"{q} {n}" for n, q in st["materials"].items())
            mark = "x" if st["progress"] >= st["minutes"] else ">" if i == p["current_stage"] else " "
            print(dim(f"    [{mark}] {st['name']} ({round(st['progress'])}/{st['minutes']} min" + (f"; {mats}" if mats else "") + ")"))
        for q in p.get("questions") or []:
            print(f"    ? {q}")
        for f in p.get("findings") or []:
            print(green(f"    found: {f}"))
        if a.verbose:
            for h in p.get("hidden") or []:
                print(dim(f"      hidden ({'found' if h['found'] else 'unseen'}): {h['fact']}"))
            for h in p["history"]:
                print(dim(f"      {fmt_time(h['ts'])} {h['result']}: {h['text']}"))
    if not r["projects"]:
        print(dim("  (none)"))
    if r.get("abilities"):
        print(bold("Abilities"))
        for a_, v in r["abilities"].items():
            print(f"  {a_}: level {v['level']} " + dim(f"({round(v['xp'])} min of practice)"))
    if r["skills"]:
        print(bold("Crafts (familiarity)"))
        for c, v in r["skills"].items():
            print(f"  {c}: level {v['level']} " + dim(f"({round(v['xp'])} min of practice)"))


def cmd_creations(pip: Pip, a) -> None:
    made = pip.call("/creations")
    if JSON_MODE:
        return out_json(made)
    print(bold("Things Pip has made"))
    for c in made:
        print(f"  {c['summary']}" + (cyan(f" [talks as {c['character']}]") if c.get("character") else ""))
    if not made:
        print(dim("  (nothing yet)"))


def cmd_memory(pip: Pip, a) -> None:
    m = pip.call("/memory")
    if JSON_MODE:
        return out_json(m)
    if not m["last_reflection_ts"]:
        print(dim("Pip hasn't reflected yet (it does at night, or: pipchat reflect)."))
        return
    print(bold("Who Pip is") + dim(f"  (last reflection {fmt_time(m['last_reflection_ts'])})"))
    print(f"  {m['self'] or dim('(no self-portrait yet)')}")
    if m["people"]:
        print(bold("People"))
        for p in m["people"]:
            print(f"  {p['name']}: {p['notes']}" + dim(f"  (last seen {fmt_time(p['last_seen'])})"))
    if m["insights"]:
        print(bold("Beliefs"))
        for i in m["insights"][:a.n]:
            print(f"  [{i['importance']:>2}] {i['text']}")
    if m["days"]:
        print(bold("Days"))
        for d in reversed(m["days"][:a.n]):
            print(f"  {dim(fmt_time(d['period_end']))} {d['text']}")


def cmd_reflect(pip: Pip, a) -> None:
    r = pip.call("/reflect", {})["reflection"]
    if JSON_MODE:
        return out_json(r)
    if not r:
        print(dim("Nothing new to reflect on (or the reflection failed - see pipchat log)."))
        return
    print(green("Pip reflected: ") + r["summary"])
    for i in r["insights"]:
        print(f"  [{i['importance']:>2}] {i['text']}")
    if r["people"]:
        print(dim("  updated notes on: " + ", ".join(r["people"])))


def cmd_recall(pip: Pip, a) -> None:
    hits = pip.call("/recall?" + urllib.parse.urlencode({"q": " ".join(a.query), "limit": a.n}))
    if JSON_MODE:
        return out_json(hits)
    for h in hits:
        print(f"  {dim(fmt_time(float(h['ts'])))} {dim('[' + h['source'] + ']')} {h['text']}")
    if not hits:
        print(dim("  nothing comes to mind"))


def cmd_letters(pip: Pip, a) -> None:
    r = pip.call(f"/letters?limit={a.n}")
    if JSON_MODE:
        return out_json(r)
    for n in r["neighbors"]:
        print(bold(n["name"]) + f" - {n['about']}")
        for line in n["life"]:
            print(dim(f"  lately: {line}"))
    if not r["neighbors"]:
        print(dim("No neighbor yet (one is invented on start unless NEIGHBOR=0)."))
    for lt in r["letters"]:
        when = fmt_time(lt["ts"]) if lt["delivered_at"] else yellow(
            f"on its way, ~{max(1, round((lt['deliver_at'] - time.time()) / 60))} min")
        extra = (f" [enclosed: {lt['enclosed']}]" if lt["enclosed"] else "") + \
                (f" [parcel: {lt['parcel']['qty']} x {lt['parcel']['name']}]" if lt["parcel"] else "")
        print(f"  {dim(when)} {bold(lt['sender'] + ' -> ' + lt['recipient'])}: {lt['text']}" + dim(extra))


def cmd_library(pip: Pip, a) -> None:
    if a.query:
        books = pip.call("/library/search?" + urllib.parse.urlencode({"q": " ".join(a.query)}))
        if JSON_MODE:
            return out_json(books)
        for b in books:
            print(f"  #{b['id']} {bold(b['title'])} - {b['authors']}" + dim(f" [{b['tags']}] {b['format'] or 'unreadable'}"))
        if not books:
            print(dim("  nothing matches"))
        return
    marks = pip.call("/library/bookmarks")
    if JSON_MODE:
        return out_json(marks)
    print(bold("Pip's reading"))
    for m in marks:
        state = "finished" if m["finished"] else "pictures only" if m["unreadable"] else f"{m['percent']}%"
        print(f"  #{m['book_id']} {m['title']} " + dim(f"({state}, {m['sessions']} sessions"
                                                      + (f", last {fmt_time(m['last_read'])})" if m["last_read"] else ")")))
    if not marks:
        print(dim("  (nothing yet)"))


def cmd_chat(pip: Pip, a) -> None:
    try:
        import readline  # noqa: F401  (line editing + history)
    except ImportError:
        pass
    print(describe_state(pip.call("/state")))
    print(dim("Type to talk to Pip. /help for commands, /quit to leave.\n"))
    parser = build_parser()
    while True:
        try:
            line = input(bold("you> ")).strip()
        except (EOFError, KeyboardInterrupt):
            print()
            return
        if not line:
            continue
        if not line.startswith("/"):
            send_and_wait(pip, line, sender=getattr(a, "sender", DEFAULT_SENDER))
            continue
        try:
            argv = shlex.split(line[1:])
        except ValueError as e:
            print(red(f"  {e}"))
            continue
        if not argv or argv[0] in ("quit", "exit", "q"):
            return
        if argv[0] in ("help", "h", "?"):
            parser.print_help()
            continue
        if argv[0] in ("chat", "say"):
            print(dim("  (just type your message)"))
            continue
        try:
            ns = parser.parse_args(argv)
            ns.func(pip, ns)
        except SystemExit:
            pass  # argparse already printed the usage error
        except urllib.error.URLError as e:
            print(red(f"  {getattr(e, 'reason', e)}"))


# --- entry --------------------------------------------------------------------

def build_parser() -> argparse.ArgumentParser:
    def common():  # fresh option objects per parser: set_defaults() mutates them in place
        cp = argparse.ArgumentParser(add_help=False)
        cp.add_argument("--url", default=argparse.SUPPRESS, help=f"Pip's address (default $PIP_URL or {DEFAULT_URL})")
        cp.add_argument("--json", action="store_true", default=argparse.SUPPRESS, help="machine-readable output")
        return cp

    ap = argparse.ArgumentParser(prog="pipchat", description="Talk to Pip", parents=[common()],
                                 epilog="Anything that isn't a command is said to Pip: pipchat \"hi!\"")
    ap.set_defaults(url=os.environ.get("PIP_URL", DEFAULT_URL), json=False, func=cmd_chat)
    sub = ap.add_subparsers(dest="command", metavar="command")

    def add(name, func, help, **kw):
        p = sub.add_parser(name, help=help, parents=[common()], **kw)
        p.set_defaults(func=func)
        return p

    p = add("chat", cmd_chat, "interactive chat (default)")
    p.add_argument("--from", dest="sender", default=DEFAULT_SENDER, help="your name, as Pip will know you")
    add("status", cmd_status, "what Pip is doing, its stats, model, pacing and tools")
    add("usage", cmd_usage, "today's token usage against the daily budget")
    add("health", cmd_health, "check that the service is up")
    p = add("notes", cmd_notes, "read Pip's journal")
    p.add_argument("section", nargs="?", choices=SECTIONS, help="only this section")
    p.add_argument("--status", choices=["open", "done", "archived"],
                   help="only open or crossed-off items, or show archived entries (hidden by default)")
    p.add_argument("-n", type=int, default=50, help="entries per section (default 50)")
    p = add("log", cmd_log, "recent events (newest last)")
    p.add_argument("count", nargs="?", type=int, help="same as -n")
    p.add_argument("-n", type=int, default=20, help="how many events (default 20)")
    p.add_argument("--kind", action="append", help="only this event kind (tick, tool, say, inbox, error, ...); repeatable")
    p = add("watch", cmd_watch, "stream events live (Ctrl-C to stop)")
    p.add_argument("--kind", action="append", help="only this event kind; repeatable")
    add("items", cmd_items, "what Pip owns")
    add("garden", cmd_garden, "Pip's garden plots")
    p = add("projects", cmd_projects, "Pip's projects, their stages and Pip's skills")
    p.add_argument("--status", choices=["active", "done", "abandoned"])
    p.add_argument("-v", "--verbose", action="store_true", help="show each work session's result")
    add("creations", cmd_creations, "things Pip has made, and what they're doing")
    p = add("memory", cmd_memory, "Pip's long-term memory: self-portrait, people, beliefs, days")
    p.add_argument("-n", type=int, default=10, help="beliefs and days to show (default 10)")
    add("reflect", cmd_reflect, "make Pip reflect now instead of waiting for the night")
    p = add("library", cmd_library, "books Pip is reading, or search the library")
    p.add_argument("query", nargs="*")
    p = add("letters", cmd_letters, "Pip's neighbor and their letters")
    p.add_argument("-n", type=int, default=20, help="letters to show (default 20)")
    p = add("recall", cmd_recall, "search Pip's memory the way its recall tool does")
    p.add_argument("query", nargs="+")
    p.add_argument("-n", type=int, default=8)
    p = add("give", cmd_give, "give Pip something and see how it reacts")
    p.add_argument("name", help='e.g. "tiny needle file"')
    p.add_argument("-q", "--quantity", type=int, default=1)
    p.add_argument("--kind", choices=["tool", "material", "food", "seed"], default="tool",
                   help="tool: kept; material: used up; food: eaten; seed: planted (default tool)")
    p.add_argument("--desc", help="short description Pip will see")
    p.add_argument("--message", help="something you say as you hand it over")
    p.add_argument("--from", dest="sender", default=DEFAULT_SENDER, help="who it's from (default $PIP_NAME or Morgan)")
    p.add_argument("--crop", help="seeds: what grows (default: name minus 'seeds')")
    p.add_argument("--grow-minutes", type=float, help="seeds: minutes to ripen (default 60)")
    p.add_argument("--yield", dest="yield_", type=int, help="seeds: crops per harvest (default 3)")
    p.add_argument("--food-value", type=float, help="seeds/food: hunger restored per portion")
    add("tick", cmd_tick, "wake Pip now")
    p = add("say", cmd_say, "say something to Pip and wait for the reply")
    p.add_argument("message", nargs="+")
    p.add_argument("--from", dest="sender", default=DEFAULT_SENDER, help="your name, as Pip will know you")
    return ap


def main() -> int:
    global JSON_MODE
    argv = sys.argv[1:]
    commands = {"chat", "status", "usage", "health", "notes", "log", "watch", "tick", "say", "give", "items", "garden", "projects", "creations", "memory", "reflect", "recall", "letters", "library", "-h", "--help"}
    # `pipchat [--json] [--url U] "some message"` -> treat the bare words as a message
    i = 0
    while i < len(argv) and argv[i] in ("--json", "--url"):
        i += 2 if argv[i] == "--url" else 1
    if i < len(argv) and argv[i] not in commands:
        argv = argv[:i] + ["say"] + argv[i:]
    args = build_parser().parse_args(argv)
    JSON_MODE = args.json
    pip = Pip(args.url)
    try:
        args.func(pip, args)
    except urllib.error.HTTPError as e:
        print(red(f"Pip answered {e.code} {e.reason} ({pip.url}). If it was just restarted, give it a few seconds."), file=sys.stderr)
        return 1
    except urllib.error.URLError as e:
        print(red(f"Can't reach Pip at {pip.url}: {e.reason}"), file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
