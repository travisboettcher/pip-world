# Copy to .env and fill in (.env is gitignored: keep real keys and tokens out of git).
# To start you only need ANTHROPIC_API_KEY; everything else has a sensible default. Costs: see "What it costs" in the README.
# Docker Compose reads this file as-is, so keep comments on their own lines.
ANTHROPIC_API_KEY=

# LLM backend: anthropic | openai_compat
LLM_BACKEND=anthropic
LLM_MODEL=claude-haiku-5-5
# Only for openai_compat (OpenAI, Ollama, vLLM...), e.g. http://ollama:11434/v1
LLM_BASE_URL=
LLM_API_KEY=
# Anthropic only: low|medium|high (empty = API default)
LLM_EFFORT=low
LLM_MAX_TOKENS=2048
# Max LLM calls per wake. >1 lets the agent act on tool results (e.g. a web search)
# immediately; 1 = strictly one call per tick.
MAX_CALLS_PER_TICK=3

# Pacing: heartbeat_events | fixed_tick | manual
PACING=heartbeat_events
HEARTBEAT_SECONDS=300
TICK_SECONDS=120
MIN_TICK_INTERVAL=15

# A public, read-only view (docs/DESIGN-public-view.md). Requests whose Host is listed here get only the scrubbed read-only pages; other hosts get the full dashboard.
# PUBLIC_REDACT: names always shown as "someone" there (visitors and people Pip keeps notes on are hidden anyway).
PUBLIC_HOSTS=
PUBLIC_REDACT=

# Hard daily cap on LLM tokens (input+output); ticks pause when exceeded
DAILY_TOKEN_BUDGET=5000000

# Comma-separated tool names to enable (web_search needs a search provider that is set up, below)
# Garden: GARDEN_PLOTS plots; GROW_SPEED>1 makes crops grow faster than real time
GARDEN_PLOTS=3
GROW_SPEED=1
# Projects: WORK_SPEED>1 makes work sessions end sooner than real time
WORK_SPEED=1
MAX_ACTIVE_PROJECTS=3
# Max companion answers per character per hour (caps Pip <-> creation back-and-forth)
COMPANION_REPLIES_PER_HOUR=4
# Long-term memory: Pip reflects once a day after this local hour (24 = never)
REFLECT_HOUR=3
# Real weather and daylight (DESIGN-weather.md). Off until WEATHER=1. WEATHER_PROVIDER picks the source; "homeassistant" is the only one so far, and it needs a token. Create a long-lived access token
# in Home Assistant (profile -> Security); only the weather entity and sun.sun are ever read, read-only. Rain speeds crops up to 15%, snow slows them.
WEATHER=0
WEATHER_PROVIDER=homeassistant
# Under Docker use the Home Assistant service name, e.g. http://home-assistant:8123
HASS_URL=http://homeassistant.local:8123
HASS_TOKEN=
WEATHER_ENTITY=weather.forecast_home

# Day and night: Pip can go to bed between BEDTIME_HOUR and WAKE_HOUR (local time); no ticks while it sleeps
SLEEP=1
BEDTIME_HOUR=22
WAKE_HOUR=6
SLEEP_RECOVER_PER_HOUR=0.25
# Firsts ("New for you"): how long a first stays news, ticks it is shown, and the most listed at once
FIRSTS_MAX_AGE_HOURS=24
FIRSTS_SHOWINGS=3
FIRSTS_SHOWN=5
# Nightly check that each insight follows from the moments it cites (one small call; 0 = off)
VERIFY_INSIGHTS=1
# The night pass: after the nightly reflection Pip may adjust its own goals (off | log = record only | apply)
NIGHT_PASS=apply
MAX_NIGHT_OPS=3
# Places you can gather at (comma-separated; empty = none): woods, junkyard
WILD_PLACES=woods,junkyard
# Reaching out: channels Pip can talk through (e.g. matrix); empty = no way to the outside world. Unprompted conversations are
# limited per day and per gap, never at night; replies inside a conversation are free. OUTREACH=off|on|log (log = record, don't send)
OUTREACH=on
OUTREACH_CHANNELS=
OUTREACH_PER_DAY=2
OUTREACH_MIN_GAP_HOURS=3
# The Matrix channel (OUTREACH_CHANNELS=matrix): the homeserver, Pip's account (created by the bootstrap script), the one private room,
# and who may talk to Pip ("@user:server=Name", comma-separated). The token is a secret.
MATRIX_HOMESERVER=
MATRIX_USER_ID=
MATRIX_ACCESS_TOKEN=
MATRIX_ROOM_ID=
MATRIX_ALLOWED=
# Pictures and writing: at most this many a day, this many minutes apart
WORKS_PER_DAY=6
WORKS_MIN_GAP_MINUTES=10
# A neighbor (invented by the GM on first start) who exchanges slow letters with Pip
NEIGHBOR=1
LETTER_DELAY_MINUTES=120
NEIGHBOR_WRITES_EVERY_HOURS=30
LETTERS_PER_DAY=3
PARCELS_PER_DAY=1
# The library: a folder of books mounted read-only at LIBRARY_PATH; no library = no place. LIBRARY_PROVIDER is auto (a Calibre library if the
# folder holds one, else a plain folder of EPUB, PDF, text and Markdown files), calibre, or folder.
LIBRARY_PATH=/library
LIBRARY_PROVIDER=auto
WALK_MINUTES=10
READ_CHARS_PER_MINUTE=700

TOOLS=say,set_activity,eat,rest,note_to_self,edit_note,resolve_note,use_item,plant,harvest,web_search,start_project,work_on,abandon_project,tend,recall,write_letter,go_to,browse,read,gather,where_to,experiment,revise_plan,sleep,undo_decision,resume_project,send_postcard,draw,write_piece,look,settle
# Web search: SEARCH_PROVIDER picks the source ("tavily" is the only one so far, and needs a key); no provider ready = no web_search tool
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=

# Emotion state (see DESIGN-emotions.md): on = tracked and shown to Pip | quiet = tracked, not shown | off
EMOTIONS=on
EMOTION_SETTLE_PER_DAY=3
